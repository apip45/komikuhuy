<!-- 
  ===========================================
  AF-Komik V2 - 403 Error Page
  ===========================================
  
  Access forbidden error display
-->

<section class="py-20">
  <div class="max-w-lg mx-auto text-center">
    <!-- Error Code -->
    <div class="text-9xl font-bold text-yellow-500 mb-4">403</div>
    
    <!-- Error Message -->
    <h1 class="text-3xl font-bold text-white mb-4">Akses Ditolak</h1>
    <p class="text-gray-400 mb-8">
      <%= typeof message !== 'undefined' ? message : 'Anda tidak memiliki izin untuk mengakses halaman ini.' %>
    </p>
    
    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" 
         class="px-8 py-3 bg-neon-600 text-white rounded-lg font-semibold hover:bg-neon-700 transition-default neon-glow">
        Kembali ke Home
      </a>
      <a href="/login" 
         class="px-8 py-3 bg-dark-400 text-gray-300 rounded-lg font-semibold hover:bg-dark-300 hover:text-white transition-default border border-dark-100">
        Login
      </a>
    </div>
    
    <!-- Decorative Element -->
    <div class="mt-12">
      <svg class="w-48 h-48 mx-auto text-dark-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" 
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
      </svg>
    </div>
  </div>
</section>
