<!-- 
  ===========================================
  AF-Komik V2 - 404 Error Page
  ===========================================
  
  Page not found error display
-->

<section class="py-20">
  <div class="max-w-lg mx-auto text-center">
    <!-- Error Code -->
    <div class="text-9xl font-bold text-neon-600 neon-text mb-4">404</div>
    
    <!-- Error Message -->
    <h1 class="text-3xl font-bold text-white mb-4">Halaman Tidak Ditemukan</h1>
    <p class="text-gray-400 mb-8">
      Maaf, halaman yang Anda cari tidak ditemukan atau mungkin telah dipindahkan.
    </p>
    
    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" 
         class="px-8 py-3 bg-neon-600 text-white rounded-lg font-semibold hover:bg-neon-700 transition-default neon-glow">
        Kembali ke Home
      </a>
      <a href="/comics" 
         class="px-8 py-3 bg-dark-400 text-gray-300 rounded-lg font-semibold hover:bg-dark-300 hover:text-white transition-default border border-dark-100">
        Browse Komik
      </a>
    </div>
    
    <!-- Decorative Element -->
    <div class="mt-12">
      <svg class="w-48 h-48 mx-auto text-dark-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" 
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
  </div>
</section>
