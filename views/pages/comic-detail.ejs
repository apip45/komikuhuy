<!-- 
  ===========================================
  AF-Komik V2 - Comic Detail Page
  ===========================================
  
  Displays detailed information about a comic.
  Features:
  - Cover image
  - Synopsis/description
  - Genre tags
  - Chapter list with navigation
  - Start reading button
  - Responsive design
  
  Data passed from controller:
  - comic: Comic object with full details
  - chapters: Array of chapter objects
  - firstChapter: First chapter for "Start Reading"
  - chapterCount: Total number of chapters
  - user: Current user (if logged in)
-->

<section class="py-8 md:py-12">
  <div class="container mx-auto px-4">
    
    <!-- Breadcrumb -->
    <nav class="mb-6">
      <ol class="flex items-center text-sm text-gray-400">
        <li>
          <a href="/" class="hover:text-neon-400 transition-colors">Beranda</a>
        </li>
        <li class="mx-2">/</li>
        <li>
          <a href="/comics" class="hover:text-neon-400 transition-colors">Komik</a>
        </li>
        <li class="mx-2">/</li>
        <li class="text-white truncate max-w-xs"><%= comic.title %></li>
      </ol>
    </nav>
    
    <!-- Comic Header -->
    <div class="bg-dark-400 rounded-xl border border-dark-100 overflow-hidden mb-8">
      <div class="md:flex">
        
        <!-- Cover Image -->
        <div class="md:w-64 lg:w-80 flex-shrink-0">
          <div class="aspect-[3/4] relative">
            <% if (comic.thumbnail) { %>
            <img 
              src="<%= comic.thumbnail %>" 
              alt="<%= comic.title %>"
              class="w-full h-full object-cover"
              onerror="this.onerror=null; this.src='/images/no-cover.png';"
            >
            <% } else { %>
            <div class="w-full h-full bg-dark-300 flex items-center justify-center">
              <svg class="w-20 h-20 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <% } %>
          </div>
        </div>
        
        <!-- Comic Info -->
        <div class="flex-1 p-6 md:p-8">
          <!-- Title -->
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-4">
            <%= comic.title %>
          </h1>
          
          <!-- Meta Info -->
          <div class="flex flex-wrap items-center gap-4 mb-6 text-sm text-gray-400">
            <!-- Chapter Count -->
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              <span><%= chapterCount %> Chapter</span>
            </div>
            
            <!-- Latest Chapter -->
            <% if (comic.latest_chapter) { %>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span>Terbaru: <%= comic.latest_chapter %></span>
            </div>
            <% } %>
            
            <!-- Last Updated -->
            <% if (comic.updated_at) { %>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>
                <%= new Date(comic.updated_at).toLocaleDateString('id-ID', { 
                  day: 'numeric', 
                  month: 'short', 
                  year: 'numeric' 
                }) %>
              </span>
            </div>
            <% } %>
          </div>
          
          <!-- Genres -->
          <% if (comic.genres && comic.genres.length > 0) { %>
          <div class="mb-6">
            <div class="flex flex-wrap gap-2">
              <% comic.genres.forEach(function(genre) { %>
              <span class="px-3 py-1 rounded-full text-sm bg-neon-600/20 text-neon-400 border border-neon-600/30">
                <%= genre %>
              </span>
              <% }); %>
            </div>
          </div>
          <% } %>
          
          <!-- Description/Synopsis -->
          <% if (comic.synopsis || comic.description) { %>
          <div class="mb-6">
            <h2 class="text-lg font-semibold text-white mb-2">Sinopsis</h2>
            <div class="text-gray-400 leading-relaxed prose-sm">
              <p><%= comic.synopsis || comic.description %></p>
            </div>
          </div>
          <% } %>
          
          <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3">
            <% if (firstChapter) { %>
            <a 
              href="/comics/<%= comic.param %>/<%= firstChapter.param %>" 
              class="inline-flex items-center gap-2 px-6 py-3 bg-neon-600 text-white rounded-lg font-semibold hover:bg-neon-700 transition-colors neon-glow">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Mulai Baca
            </a>
            <% } %>
            
            <!-- Bookmark Button (placeholder for future) -->
            <button 
              type="button" 
              disabled
              class="inline-flex items-center gap-2 px-6 py-3 bg-dark-300 text-gray-400 rounded-lg font-semibold cursor-not-allowed"
              title="Fitur bookmark akan hadir segera">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
              </svg>
              Bookmark
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Chapter List -->
    <div class="bg-dark-400 rounded-xl border border-dark-100 overflow-hidden">
      <!-- Chapter List Header -->
      <div class="p-4 md:p-6 border-b border-dark-100 flex items-center justify-between">
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <svg class="w-6 h-6 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
          </svg>
          Daftar Chapter
        </h2>
        <span class="text-sm text-gray-400"><%= chapterCount %> chapter</span>
      </div>
      
      <!-- Chapter List Content -->
      <div class="max-h-[600px] overflow-y-auto">
        <% if (chapters.length === 0) { %>
        <!-- No Chapters -->
        <div class="p-8 text-center">
          <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <p class="text-gray-400">Belum ada chapter tersedia.</p>
        </div>
        <% } else { %>
        
        <!-- Chapter Items -->
        <div class="divide-y divide-dark-100">
          <% chapters.forEach(function(chapter) { %>
          <a 
            href="/comics/<%= comic.param %>/<%= chapter.param %>" 
            class="flex items-center justify-between p-4 hover:bg-dark-300 transition-colors group">
            <div class="flex items-center gap-3">
              <!-- Chapter Icon -->
              <div class="w-10 h-10 rounded-lg bg-dark-300 flex items-center justify-center group-hover:bg-neon-600/20 transition-colors">
                <svg class="w-5 h-5 text-gray-400 group-hover:text-neon-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              
              <!-- Chapter Info -->
              <div>
                <h3 class="text-white font-medium group-hover:text-neon-400 transition-colors">
                  <%= chapter.chapter_label %>
                </h3>
                <% if (chapter.release_date) { %>
                <p class="text-xs text-gray-500">
                  <%= new Date(chapter.release_date).toLocaleDateString('id-ID', { 
                    day: 'numeric', 
                    month: 'short', 
                    year: 'numeric' 
                  }) %>
                </p>
                <% } %>
              </div>
            </div>
            
            <!-- Arrow -->
            <svg class="w-5 h-5 text-gray-500 group-hover:text-neon-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>
    
    <!-- Back to List -->
    <div class="mt-6 text-center">
      <a href="/comics" class="text-gray-400 hover:text-neon-400 text-sm transition-colors">
        &larr; Kembali ke Daftar Komik
      </a>
    </div>
    
  </div>
</section>
