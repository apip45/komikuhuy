<!-- 
  ===========================================
  AF-Komik V2 - User Profile Page
  ===========================================
  
  Displays user profile information:
  - Username
  - Email
  - Role badge
  - Member since date
  - Last login date
  - Account actions (logout, change password)
-->

<section class="py-12 md:py-20">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Profil Saya</h1>
      <p class="text-gray-400">Kelola informasi akun dan preferensi Anda</p>
    </div>
    
    <!-- Success Message -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-6 p-4 bg-green-500/10 border border-green-500/30 rounded-lg">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <p class="text-green-400 text-sm"><%= success %></p>
      </div>
    </div>
    <% } %>
    
    <!-- Error Message -->
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-red-400 text-sm"><%= error %></p>
      </div>
    </div>
    <% } %>
    
    <!-- Profile Card -->
    <div class="bg-dark-400 rounded-xl border border-dark-100 overflow-hidden">
      
      <!-- Profile Header with Avatar -->
      <div class="p-6 md:p-8 bg-gradient-to-r from-neon-600/20 to-neon-800/20 border-b border-dark-100">
        <div class="flex items-center gap-4">
          <!-- Avatar -->
          <div class="w-20 h-20 rounded-full bg-neon-600/30 border-2 border-neon-500 flex items-center justify-center">
            <span class="text-3xl font-bold text-neon-400">
              <%= user.username.charAt(0).toUpperCase() %>
            </span>
          </div>
          
          <!-- Basic Info -->
          <div>
            <h2 class="text-2xl font-bold text-white"><%= user.username %></h2>
            <p class="text-gray-400"><%= user.email %></p>
            
            <!-- Role Badge -->
            <% if (user.role === 'admin') { %>
            <span class="inline-flex items-center mt-2 px-3 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30">
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"></path>
              </svg>
              Administrator
            </span>
            <% } else { %>
            <span class="inline-flex items-center mt-2 px-3 py-1 rounded-full text-xs font-medium bg-neon-500/20 text-neon-400 border border-neon-500/30">
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
              </svg>
              Member
            </span>
            <% } %>
          </div>
        </div>
      </div>
      
      <!-- Profile Details -->
      <div class="p-6 md:p-8 space-y-6">
        
        <!-- Account Information Section -->
        <div>
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Informasi Akun
          </h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Username -->
            <div class="bg-dark-300 rounded-lg p-4">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Username</p>
              <p class="text-white font-medium"><%= user.username %></p>
            </div>
            
            <!-- Email -->
            <div class="bg-dark-300 rounded-lg p-4">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Email</p>
              <p class="text-white font-medium"><%= user.email %></p>
            </div>
            
            <!-- Member Since -->
            <div class="bg-dark-300 rounded-lg p-4">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Bergabung Sejak</p>
              <p class="text-white font-medium">
                <%= new Date(user.createdAt).toLocaleDateString('id-ID', { 
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric'
                }) %>
              </p>
            </div>
            
            <!-- Last Login -->
            <div class="bg-dark-300 rounded-lg p-4">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Terakhir Login</p>
              <p class="text-white font-medium">
                <% if (user.lastLogin) { %>
                  <%= new Date(user.lastLogin).toLocaleDateString('id-ID', { 
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  }) %>
                <% } else { %>
                  -
                <% } %>
              </p>
            </div>
          </div>
        </div>
        
        <!-- Reading Stats Section (Placeholder for future) -->
        <div>
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            Statistik Membaca
          </h3>
          
          <div class="grid grid-cols-3 gap-4">
            <div class="bg-dark-300 rounded-lg p-4 text-center">
              <p class="text-2xl font-bold text-neon-400">0</p>
              <p class="text-xs text-gray-500 mt-1">Komik Dibaca</p>
            </div>
            <div class="bg-dark-300 rounded-lg p-4 text-center">
              <p class="text-2xl font-bold text-neon-400">0</p>
              <p class="text-xs text-gray-500 mt-1">Chapter Selesai</p>
            </div>
            <div class="bg-dark-300 rounded-lg p-4 text-center">
              <p class="text-2xl font-bold text-neon-400">0</p>
              <p class="text-xs text-gray-500 mt-1">Favorit</p>
            </div>
          </div>
          
          <p class="text-xs text-gray-500 mt-3 text-center italic">
            * Fitur statistik akan tersedia pada update mendatang
          </p>
        </div>
        
        <!-- Actions Section -->
        <div class="pt-6 border-t border-dark-100">
          <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Pengaturan Akun
          </h3>
          
          <div class="flex flex-wrap gap-3">
            <!-- Edit Profile Button (placeholder) -->
            <button 
              type="button" 
              disabled
              class="px-4 py-2 bg-dark-300 text-gray-400 rounded-lg text-sm cursor-not-allowed"
              title="Segera hadir">
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit Profil
            </button>
            
            <!-- Change Password Button (placeholder) -->
            <button 
              type="button" 
              disabled
              class="px-4 py-2 bg-dark-300 text-gray-400 rounded-lg text-sm cursor-not-allowed"
              title="Segera hadir">
              <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
              </svg>
              Ganti Password
            </button>
            
            <!-- Logout Button -->
            <form action="/logout" method="POST" class="inline">
              <button 
                type="submit" 
                class="px-4 py-2 bg-red-500/20 text-red-400 hover:bg-red-500/30 rounded-lg text-sm transition-default">
                <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Logout
              </button>
            </form>
          </div>
        </div>
        
        <!-- Admin Panel Link (only for admins) -->
        <% if (user.role === 'admin') { %>
        <div class="pt-6 border-t border-dark-100">
          <a 
            href="/admin" 
            class="inline-flex items-center px-4 py-2 bg-red-600 text-white hover:bg-red-700 rounded-lg text-sm transition-default">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
            Akses Admin Panel
          </a>
        </div>
        <% } %>
        
      </div>
    </div>
    
    <!-- Back to Home -->
    <div class="mt-6 text-center">
      <a href="/" class="text-gray-500 hover:text-gray-400 text-sm transition-default">
        &larr; Kembali ke Beranda
      </a>
    </div>
  </div>
</section>
