<!-- 
  ===========================================
  AF-Komik V2 - Homepage
  ===========================================
  
  Main landing page displaying:
  - Hero section with call-to-action
  - Featured comics section (placeholder)
  - Latest updates section (placeholder)
-->

<!-- Hero Section -->
<section class="relative py-12 md:py-20">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 neon-text">
      Baca Komik Favoritmu
    </h1>
    <p class="text-xl text-gray-400 mb-8 max-w-2xl mx-auto">
      Nikmati ribuan koleksi manga, manhwa, dan manhua terbaru dengan kualitas terbaik. 
      Gratis dan mudah diakses kapan saja.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/comics" 
         class="px-8 py-3 bg-neon-600 text-white rounded-lg font-semibold hover:bg-neon-700 transition-default neon-glow">
        Mulai Membaca
      </a>
      <a href="/register" 
         class="px-8 py-3 bg-dark-200 text-gray-300 rounded-lg font-semibold hover:bg-dark-100 hover:text-white transition-default border border-dark-100">
        Daftar Gratis
      </a>
    </div>
  </div>
</section>

<!-- Featured Comics Section -->
<section class="py-12">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold text-white">
      <span class="text-neon-400">Featured</span> Comics
    </h2>
    <a href="/comics" class="text-neon-400 hover:text-neon-300 transition-default">
      View All &rarr;
    </a>
  </div>
  
  <!-- Comics Grid -->
  <% if (featuredComics && featuredComics.length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
      <% featuredComics.forEach(comic => { %>
      <a href="/comics/<%= comic.param %>" class="group block">
        <div class="relative overflow-hidden rounded-lg bg-dark-400 aspect-[3/4]">
          <!-- Comic Thumbnail -->
          <% if (comic.thumbnail) { %>
            <img src="<%= comic.thumbnail %>" 
                 alt="<%= comic.title %>"
                 class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                 loading="lazy"
                 onerror="this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' fill=\'none\' viewBox=\'0 0 24 24\' stroke=\'%236b7280\'%3E%3Cpath stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'/%3E%3C/svg%3E'">
          <% } else { %>
            <div class="absolute inset-0 flex items-center justify-center text-gray-600">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
          <% } %>
          
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-dark-500 via-transparent to-transparent z-10"></div>
          
          <!-- Comic Info -->
          <div class="absolute bottom-0 left-0 right-0 p-3 z-20">
            <h3 class="text-white text-sm font-medium truncate group-hover:text-neon-400 transition-colors" 
                title="<%= comic.title %>">
              <%= comic.title %>
            </h3>
            <% if (comic.latest_chapter) { %>
              <p class="text-gray-400 text-xs truncate"><%= comic.latest_chapter %></p>
            <% } %>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-12 text-gray-500">
      <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p>Belum ada komik tersedia.</p>
      <p class="text-sm mt-2">Jalankan scraper untuk mengisi database.</p>
    </div>
  <% } %>
</section>

<!-- Latest Updates Section -->
<section class="py-12">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold text-white">
      <span class="text-neon-400">Latest</span> Updates
    </h2>
    <a href="/comics" class="text-neon-400 hover:text-neon-300 transition-default">
      View All &rarr;
    </a>
  </div>
  
  <!-- Latest Updates List -->
  <% if (latestUpdates && latestUpdates.length > 0) { %>
    <div class="grid gap-4">
      <% latestUpdates.forEach(comic => { %>
      <a href="/comics/<%= comic.param %>" 
         class="flex items-center gap-4 p-4 bg-dark-400 rounded-lg hover:bg-dark-300 transition-default group">
        <!-- Comic Thumbnail -->
        <div class="w-16 h-20 bg-dark-200 rounded flex-shrink-0 overflow-hidden">
          <% if (comic.thumbnail) { %>
            <img src="<%= comic.thumbnail %>" 
                 alt="<%= comic.title %>"
                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                 loading="lazy"
                 onerror="this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center text-gray-600\'><svg class=\'w-8 h-8\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'></path></svg></div>'">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-gray-600">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
          <% } %>
        </div>
        
        <!-- Comic Info -->
        <div class="flex-grow min-w-0">
          <h3 class="text-white font-medium truncate group-hover:text-neon-400 transition-colors"
              title="<%= comic.title %>">
            <%= comic.title %>
          </h3>
          
          <!-- Latest Chapter Badge -->
          <% if (comic.latest_chapter) { %>
            <div class="flex flex-wrap gap-2 mt-2">
              <span class="text-xs px-2 py-1 bg-neon-600/20 text-neon-400 rounded">
                <%= comic.latest_chapter %>
              </span>
            </div>
          <% } %>
          
          <!-- Genres (if available) -->
          <% if (comic.genres && Array.isArray(comic.genres) && comic.genres.length > 0) { %>
            <div class="flex flex-wrap gap-1 mt-2">
              <% comic.genres.slice(0, 3).forEach(genre => { %>
                <span class="text-xs px-2 py-0.5 bg-dark-200 text-gray-400 rounded">
                  <%= genre %>
                </span>
              <% }); %>
              <% if (comic.genres.length > 3) { %>
                <span class="text-xs px-2 py-0.5 text-gray-500">
                  +<%= comic.genres.length - 3 %>
                </span>
              <% } %>
            </div>
          <% } %>
        </div>
        
        <!-- Updated Time -->
        <div class="text-right text-sm text-gray-500 flex-shrink-0 hidden sm:block">
          <% if (comic.updated_at) { %>
            <% 
              const now = new Date();
              const updated = new Date(comic.updated_at);
              const diffMs = now - updated;
              const diffMins = Math.floor(diffMs / 60000);
              const diffHours = Math.floor(diffMins / 60);
              const diffDays = Math.floor(diffHours / 24);
              
              let timeAgo = '';
              if (diffMins < 60) {
                timeAgo = diffMins <= 1 ? 'Just now' : `${diffMins} minutes ago`;
              } else if (diffHours < 24) {
                timeAgo = diffHours === 1 ? '1 hour ago' : `${diffHours} hours ago`;
              } else if (diffDays < 7) {
                timeAgo = diffDays === 1 ? '1 day ago' : `${diffDays} days ago`;
              } else {
                timeAgo = updated.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });
              }
            %>
            <p><%= timeAgo %></p>
          <% } %>
        </div>
      </a>
      <% }); %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-12 text-gray-500">
      <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p>Belum ada update terbaru.</p>
    </div>
  <% } %>
</section>

<!-- Statistics Section -->
<section class="py-12">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-dark-400 rounded-lg p-6 text-center">
      <div class="text-3xl font-bold text-neon-400 mb-2">
        <%= stats.totalComics > 0 ? stats.totalComics.toLocaleString() : '0' %>
      </div>
      <div class="text-gray-400 text-sm">Total Comics</div>
    </div>
    <div class="bg-dark-400 rounded-lg p-6 text-center">
      <div class="text-3xl font-bold text-neon-400 mb-2">
        <%= stats.totalChapters > 0 ? stats.totalChapters.toLocaleString() : '0' %>
      </div>
      <div class="text-gray-400 text-sm">Chapters</div>
    </div>
    <div class="bg-dark-400 rounded-lg p-6 text-center">
      <div class="text-3xl font-bold text-neon-400 mb-2">
        <%= stats.totalUsers > 0 ? stats.totalUsers.toLocaleString() : '0' %>
      </div>
      <div class="text-gray-400 text-sm">Users</div>
    </div>
    <div class="bg-dark-400 rounded-lg p-6 text-center">
      <div class="text-3xl font-bold text-neon-400 mb-2">Daily</div>
      <div class="text-gray-400 text-sm">Updates</div>
    </div>
  </div>
</section>
