<!-- 
  ===========================================
  AF-Komik V2 - Comics List Page
  ===========================================
  
  Displays a grid of all available comics.
  Features:
  - Thumbnail grid layout
  - Comic title and latest chapter
  - Genre tags
  - Pagination
  - Responsive design (mobile-friendly)
  
  Data passed from controller:
  - comics: Array of comic objects
  - pagination: Pagination metadata
  - user: Current user (if logged in)
-->

<section class="py-8 md:py-12">
  <div class="container mx-auto px-4">
    
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Daftar Komik</h1>
      <p class="text-gray-400">
        <% if (search.keyword || search.genre) { %>
          Hasil pencarian: 
          <span class="text-neon-400 font-semibold"><%= pagination.totalItems %></span> komik ditemukan
        <% } else { %>
          Jelajahi koleksi komik kami. Total: 
          <span class="text-neon-400 font-semibold"><%= pagination.totalItems %></span> komik
        <% } %>
      </p>
    </div>

    <!-- Search and Filter Section -->
    <div class="mb-8 space-y-4">
      <form action="/comics" method="GET" class="flex flex-col md:flex-row gap-4">
        <!-- Search Input -->
        <div class="flex-grow relative">
          <input 
            type="text" 
            name="search" 
            placeholder="Cari komik berdasarkan judul..." 
            value="<%= search.keyword %>"
            class="w-full px-4 py-3 pl-12 bg-dark-400 text-white rounded-lg border border-dark-100 focus:border-neon-600 focus:outline-none focus:ring-2 focus:ring-neon-600/20 transition-all"
          >
          <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <!-- Genre Filter -->
        <div class="md:w-64">
          <select 
            name="genre" 
            class="w-full px-4 py-3 bg-dark-400 text-white rounded-lg border border-dark-100 focus:border-neon-600 focus:outline-none focus:ring-2 focus:ring-neon-600/20 transition-all appearance-none cursor-pointer"
            onchange="this.form.submit()"
          >
            <option value="">Semua Genre</option>
            <% if (allGenres && allGenres.length > 0) { %>
              <% allGenres.forEach(genre => { %>
                <option value="<%= genre %>" <%= search.genre === genre ? 'selected' : '' %>>
                  <%= genre %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Search Button -->
        <button 
          type="submit" 
          class="px-6 py-3 bg-neon-600 text-white rounded-lg font-semibold hover:bg-neon-700 transition-all neon-glow flex items-center justify-center gap-2 md:w-auto"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>Cari</span>
        </button>

        <!-- Reset Button (show if filtered) -->
        <% if (search.keyword || search.genre) { %>
        <a 
          href="/comics" 
          class="px-6 py-3 bg-dark-300 text-gray-300 rounded-lg font-semibold hover:bg-dark-200 hover:text-white transition-all flex items-center justify-center gap-2 md:w-auto border border-dark-100"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span>Reset</span>
        </a>
        <% } %>
      </form>

      <!-- Active Filters Display -->
      <% if (search.keyword || search.genre) { %>
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm text-gray-400">Filter aktif:</span>
        <% if (search.keyword) { %>
        <div class="flex items-center gap-2 px-3 py-1 bg-neon-600/20 text-neon-400 rounded-lg text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>"<%= search.keyword %>"</span>
        </div>
        <% } %>
        <% if (search.genre) { %>
        <div class="flex items-center gap-2 px-3 py-1 bg-purple-600/20 text-purple-400 rounded-lg text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <span><%= search.genre %></span>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
    
    <!-- Comics Grid -->
    <% if (comics.length === 0) { %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-20">
      <svg class="w-24 h-24 text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      <h3 class="text-xl font-semibold text-gray-400 mb-2">Belum Ada Komik</h3>
      <p class="text-gray-500">Komik akan segera tersedia.</p>
    </div>
    <% } else { %>
    
    <!-- Comic Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4 md:gap-6">
      <% comics.forEach(function(comic) { %>
      <a href="/comics/<%= comic.param %>" class="group">
        <div class="bg-dark-400 rounded-lg overflow-hidden border border-dark-100 hover:border-neon-600/50 transition-all duration-300 hover:shadow-lg hover:shadow-neon-600/10">
          <!-- Thumbnail -->
          <div class="aspect-[3/4] relative overflow-hidden">
            <% if (comic.thumbnail) { %>
            <img 
              src="<%= comic.thumbnail %>" 
              alt="<%= comic.title %>"
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror="this.onerror=null; this.src='/images/no-cover.png';"
            >
            <% } else { %>
            <div class="w-full h-full bg-dark-300 flex items-center justify-center">
              <svg class="w-12 h-12 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <% } %>
            
            <!-- Latest Chapter Badge -->
            <% if (comic.latest_chapter) { %>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
              <span class="text-xs text-neon-400 font-medium">
                <%= comic.latest_chapter %>
              </span>
            </div>
            <% } %>
          </div>
          
          <!-- Comic Info -->
          <div class="p-3">
            <h3 class="text-sm font-semibold text-white line-clamp-2 group-hover:text-neon-400 transition-colors">
              <%= comic.title %>
            </h3>
            
            <!-- Genres -->
            <% if (comic.genres && comic.genres.length > 0) { %>
            <div class="mt-2 flex flex-wrap gap-1">
              <% comic.genres.slice(0, 2).forEach(function(genre) { %>
              <span class="text-xs px-2 py-0.5 rounded bg-dark-300 text-gray-400">
                <%= genre %>
              </span>
              <% }); %>
              <% if (comic.genres.length > 2) { %>
              <span class="text-xs px-2 py-0.5 rounded bg-dark-300 text-gray-400">
                +<%= comic.genres.length - 2 %>
              </span>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
      </a>
      <% }); %>
    </div>
    
    <!-- Pagination -->
    <% if (pagination.total > 1) { %>
    <div class="mt-8 flex justify-center">
      <nav class="flex items-center gap-2">
        <!-- Previous Button -->
        <% if (pagination.hasPrev) { %>
        <a 
          href="/comics?page=<%= pagination.current - 1 %>&limit=<%= pagination.limit %>" 
          class="px-4 py-2 bg-dark-400 border border-dark-100 rounded-lg text-gray-400 hover:text-white hover:border-neon-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 border border-dark-100 rounded-lg text-gray-600 cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </span>
        <% } %>
        
        <!-- Page Numbers -->
        <div class="flex items-center gap-1">
          <% 
          // Show max 5 page numbers centered around current page
          let startPage = Math.max(1, pagination.current - 2);
          let endPage = Math.min(pagination.total, startPage + 4);
          if (endPage - startPage < 4) {
            startPage = Math.max(1, endPage - 4);
          }
          %>
          
          <% if (startPage > 1) { %>
          <a href="/comics?page=1&limit=<%= pagination.limit %>" class="px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-dark-300 transition-colors">1</a>
          <% if (startPage > 2) { %>
          <span class="px-2 text-gray-600">...</span>
          <% } %>
          <% } %>
          
          <% for (let i = startPage; i <= endPage; i++) { %>
          <% if (i === pagination.current) { %>
          <span class="px-3 py-2 rounded-lg bg-neon-600 text-white font-semibold">
            <%= i %>
          </span>
          <% } else { %>
          <a href="/comics?page=<%= i %>&limit=<%= pagination.limit %>" class="px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-dark-300 transition-colors">
            <%= i %>
          </a>
          <% } %>
          <% } %>
          
          <% if (endPage < pagination.total) { %>
          <% if (endPage < pagination.total - 1) { %>
          <span class="px-2 text-gray-600">...</span>
          <% } %>
          <a href="/comics?page=<%= pagination.total %>&limit=<%= pagination.limit %>" class="px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-dark-300 transition-colors"><%= pagination.total %></a>
          <% } %>
        </div>
        
        <!-- Next Button -->
        <% if (pagination.hasNext) { %>
        <a 
          href="/comics?page=<%= pagination.current + 1 %>&limit=<%= pagination.limit %>" 
          class="px-4 py-2 bg-dark-400 border border-dark-100 rounded-lg text-gray-400 hover:text-white hover:border-neon-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 border border-dark-100 rounded-lg text-gray-600 cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
        <% } %>
      </nav>
    </div>
    
    <!-- Pagination Info -->
    <div class="mt-4 text-center text-sm text-gray-500">
      Halaman <%= pagination.current %> dari <%= pagination.total %> 
      (<%= (pagination.current - 1) * pagination.limit + 1 %> - <%= Math.min(pagination.current * pagination.limit, pagination.totalItems) %> dari <%= pagination.totalItems %> komik)
    </div>
    <% } %>
    
    <% } %>
    
  </div>
</section>
