<!-- 
  ===========================================
  AF-Komik V2 - Reading History Page
  ===========================================
  
  Displays user's reading history (recently read comics).
  Features:
  - List of recently read comics with last chapter
  - Resume reading button
  - Remove single entry
  - Clear all history
  - Pagination
  - Empty state
  
  Data passed from controller:
  - history: Array of history objects
  - pagination: Pagination metadata
  - user: Current user
-->

<section class="py-8 md:py-12">
  <div class="container mx-auto px-4">
    
    <!-- Page Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">
          <span class="text-neon-400">📖</span> Riwayat Bacaan
        </h1>
        <p class="text-gray-400">
          <% if (pagination.totalItems > 0) { %>
            Kamu telah membaca <span class="text-neon-400 font-semibold"><%= pagination.totalItems %></span> komik
          <% } else { %>
            Belum ada riwayat bacaan
          <% } %>
        </p>
      </div>
      
      <!-- Action buttons -->
      <div class="flex gap-3">
        <% if (pagination.totalItems > 0) { %>
        <form action="/my/history/clear" method="POST" onsubmit="return confirm('Hapus semua riwayat bacaan?')">
          <button type="submit" class="px-4 py-2 bg-red-600/80 text-white rounded-lg hover:bg-red-500 transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            Hapus Semua
          </button>
        </form>
        <% } %>
        <a href="/comics" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Jelajahi Komik
        </a>
      </div>
    </div>
    
    <!-- Success/Error Messages -->
    <% if (query && (query.success || query.error || query.info)) { %>
    <% const msg = query.success || query.error || query.info; %>
    <% const type = query.success ? 'success' : (query.error ? 'error' : 'info'); %>
    <div class="mb-6 p-4 rounded-lg <%= type === 'success' ? 'bg-green-900/30 border border-green-700 text-green-400' : (type === 'error' ? 'bg-red-900/30 border border-red-700 text-red-400' : 'bg-blue-900/30 border border-blue-700 text-blue-400') %>">
      <%= msg %>
    </div>
    <% } %>
    
    <!-- History List -->
    <% if (history.length === 0) { %>
    <!-- Empty State -->
    <div class="flex flex-col items-center justify-center py-20">
      <svg class="w-24 h-24 text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-xl font-semibold text-gray-400 mb-2">Belum Ada Riwayat</h3>
      <p class="text-gray-500 mb-6 text-center">Mulai baca komik untuk melihat riwayat bacaanmu di sini.</p>
      <a href="/comics" class="px-6 py-3 bg-neon-600 text-white font-semibold rounded-lg hover:bg-neon-500 transition-colors">
        Jelajahi Komik
      </a>
    </div>
    <% } else { %>
    
    <!-- History Cards -->
    <div class="space-y-4">
      <% history.forEach(function(item) { %>
      <div class="bg-dark-400 rounded-lg border border-dark-100 hover:border-neon-600/30 transition-all duration-300 overflow-hidden">
        <div class="flex flex-col sm:flex-row">
          <!-- Thumbnail -->
          <a href="/comics/<%= item.comicParam %>" class="sm:w-32 flex-shrink-0">
            <div class="aspect-[3/4] sm:h-full relative overflow-hidden">
              <% if (item.cachedData && item.cachedData.comicThumbnail) { %>
              <img 
                src="<%= item.cachedData.comicThumbnail %>" 
                alt="<%= item.cachedData.comicTitle %>"
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.onerror=null; this.src='/images/no-cover.png';"
              >
              <% } else { %>
              <div class="w-full h-full bg-dark-300 flex items-center justify-center">
                <svg class="w-10 h-10 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <% } %>
            </div>
          </a>
          
          <!-- Content -->
          <div class="flex-1 p-4 flex flex-col justify-between">
            <div>
              <!-- Comic Title -->
              <a href="/comics/<%= item.comicParam %>" class="block">
                <h3 class="text-lg font-semibold text-white hover:text-neon-400 transition-colors line-clamp-1">
                  <%= item.cachedData && item.cachedData.comicTitle ? item.cachedData.comicTitle : item.comicParam %>
                </h3>
              </a>
              
              <!-- Last Read Chapter -->
              <a 
                href="/comics/<%= item.comicParam %>/<%= item.chapterParam %>" 
                class="inline-block mt-2 text-sm text-neon-400 hover:text-neon-300 transition-colors"
              >
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  Terakhir: <%= item.cachedData && item.cachedData.chapterLabel ? item.cachedData.chapterLabel : item.chapterParam %>
                </span>
              </a>
              
              <!-- Last Read Time -->
              <p class="text-xs text-gray-500 mt-2">
                <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Dibaca: <%= new Date(item.lastReadAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </p>
            </div>
            
            <!-- Action Buttons -->
            <div class="mt-4 flex flex-wrap gap-2">
              <!-- Resume Reading -->
              <a 
                href="/resume/<%= item.comicParam %>" 
                class="px-4 py-2 bg-neon-600 text-white text-sm font-medium rounded-lg hover:bg-neon-500 transition-colors flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Lanjutkan
              </a>
              
              <!-- View Comic -->
              <a 
                href="/comics/<%= item.comicParam %>" 
                class="px-4 py-2 bg-dark-300 text-gray-300 text-sm font-medium rounded-lg hover:bg-dark-200 transition-colors flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                Detail
              </a>
              
              <!-- Remove from History -->
              <form action="/my/history/<%= item.comicParam %>/remove" method="POST" class="inline" onsubmit="return confirm('Hapus dari riwayat?')">
                <button 
                  type="submit" 
                  class="px-4 py-2 bg-dark-300 text-red-400 text-sm font-medium rounded-lg hover:bg-red-600/20 transition-colors flex items-center gap-2"
                  title="Hapus dari Riwayat"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  Hapus
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    
    <!-- Pagination -->
    <% if (pagination.total > 1) { %>
    <div class="mt-12 flex justify-center">
      <nav class="flex items-center gap-2">
        <!-- Previous Button -->
        <% if (pagination.hasPrev) { %>
        <a href="/my/history?page=<%= pagination.current - 1 %>" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 text-gray-600 rounded-lg cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </span>
        <% } %>
        
        <!-- Page Numbers -->
        <% 
        const maxPages = 5;
        let startPage = Math.max(1, pagination.current - Math.floor(maxPages / 2));
        let endPage = Math.min(pagination.total, startPage + maxPages - 1);
        if (endPage - startPage + 1 < maxPages) {
          startPage = Math.max(1, endPage - maxPages + 1);
        }
        %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
        <a 
          href="/my/history?page=<%= i %>" 
          class="px-4 py-2 rounded-lg transition-colors <%= i === pagination.current ? 'bg-neon-600 text-white' : 'bg-dark-300 text-gray-300 hover:bg-dark-200' %>"
        >
          <%= i %>
        </a>
        <% } %>
        
        <!-- Next Button -->
        <% if (pagination.hasNext) { %>
        <a href="/my/history?page=<%= pagination.current + 1 %>" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 text-gray-600 rounded-lg cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
        <% } %>
      </nav>
    </div>
    <% } %>
    
    <% } %>
  </div>
</section>
