<%# Admin Users Management Page %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h2 class="text-2xl font-bold text-white">User Management</h2>
    <p class="text-gray-400 text-sm mt-1">Manage user accounts, roles, and permissions</p>
  </div>
  
  <!-- Search -->
  <form action="/admin/users" method="GET" class="flex gap-2">
    <input 
      type="text" 
      name="search" 
      value="<%= search %>" 
      placeholder="Search users..."
      class="px-4 py-2 bg-dark-300 border border-dark-100 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-neon-600 w-64"
    >
    <button type="submit" class="px-4 py-2 bg-neon-600 hover:bg-neon-700 text-white rounded-lg transition-colors">
      Search
    </button>
    <% if (search) { %>
    <a href="/admin/users" class="px-4 py-2 bg-dark-300 hover:bg-dark-200 text-gray-300 rounded-lg transition-colors">
      Clear
    </a>
    <% } %>
  </form>
</div>

<!-- Stats Bar -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="bg-dark-300 rounded-lg p-4 text-center">
    <p class="text-2xl font-bold text-white"><%= totalUsers %></p>
    <p class="text-sm text-gray-400">Total Users</p>
  </div>
  <div class="bg-dark-300 rounded-lg p-4 text-center">
    <p class="text-2xl font-bold text-neon-400"><%= users.filter(u => u.role === 'admin').length %></p>
    <p class="text-sm text-gray-400">Admins</p>
  </div>
  <div class="bg-dark-300 rounded-lg p-4 text-center">
    <p class="text-2xl font-bold text-green-400"><%= users.filter(u => u.isActive !== false).length %></p>
    <p class="text-sm text-gray-400">Active</p>
  </div>
  <div class="bg-dark-300 rounded-lg p-4 text-center">
    <p class="text-2xl font-bold text-red-400"><%= users.filter(u => u.isActive === false).length %></p>
    <p class="text-sm text-gray-400">Disabled</p>
  </div>
</div>

<!-- Users Table -->
<div class="card rounded-xl overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-dark-300">
        <tr>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">User</th>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Email</th>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Role</th>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Joined</th>
          <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-dark-100">
        <% if (users.length === 0) { %>
        <tr>
          <td colspan="6" class="px-6 py-12 text-center text-gray-400">
            <svg class="w-12 h-12 mx-auto mb-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p>No users found</p>
          </td>
        </tr>
        <% } %>
        
        <% users.forEach(u => { %>
        <tr class="hover:bg-dark-300/50 transition-colors">
          <!-- User Info -->
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-neon-600/30 flex items-center justify-center">
                <span class="text-neon-400 font-medium"><%= u.username?.[0]?.toUpperCase() || '?' %></span>
              </div>
              <div>
                <p class="text-white font-medium"><%= u.username %></p>
                <p class="text-xs text-gray-500">ID: <%= u._id.toString().slice(-8) %></p>
              </div>
            </div>
          </td>
          
          <!-- Email -->
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="text-gray-300"><%= u.email %></span>
          </td>
          
          <!-- Role -->
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-3 py-1 text-xs font-medium rounded-full <%= u.role === 'admin' ? 'bg-neon-600/20 text-neon-400' : 'bg-gray-600/20 text-gray-400' %>">
              <%= u.role || 'user' %>
            </span>
          </td>
          
          <!-- Status -->
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full <%= u.isActive !== false ? 'bg-green-400' : 'bg-red-400' %>"></span>
              <span class="text-sm <%= u.isActive !== false ? 'text-green-400' : 'text-red-400' %>">
                <%= u.isActive !== false ? 'Active' : 'Disabled' %>
              </span>
            </span>
          </td>
          
          <!-- Joined Date -->
          <td class="px-6 py-4 whitespace-nowrap text-gray-400 text-sm">
            <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'N/A' %>
          </td>
          
          <!-- Actions -->
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex items-center gap-2">
              
              <!-- Change Role -->
              <div class="relative" x-data="{ open: false }">
                <button 
                  onclick="toggleDropdown(this)" 
                  class="p-2 text-gray-400 hover:text-neon-400 hover:bg-dark-200 rounded transition-colors"
                  title="Change Role"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                </button>
                <div class="dropdown-menu hidden absolute right-0 mt-2 w-32 bg-dark-200 border border-dark-100 rounded-lg shadow-lg z-10">
                  <form action="/admin/users/<%= u._id %>/role" method="POST">
                    <input type="hidden" name="role" value="user">
                    <button type="submit" class="w-full px-4 py-2 text-left text-sm text-gray-300 hover:bg-dark-100 hover:text-white rounded-t-lg <%= u.role !== 'admin' ? 'bg-dark-100' : '' %>">
                      User
                    </button>
                  </form>
                  <form action="/admin/users/<%= u._id %>/role" method="POST">
                    <input type="hidden" name="role" value="admin">
                    <button type="submit" class="w-full px-4 py-2 text-left text-sm text-gray-300 hover:bg-dark-100 hover:text-white rounded-b-lg <%= u.role === 'admin' ? 'bg-dark-100' : '' %>">
                      Admin
                    </button>
                  </form>
                </div>
              </div>
              
              <!-- Reset Password -->
              <form action="/admin/users/<%= u._id %>/reset-password" method="POST" onsubmit="return confirm('Reset password for <%= u.username %>?')">
                <button 
                  type="submit" 
                  class="p-2 text-gray-400 hover:text-yellow-400 hover:bg-dark-200 rounded transition-colors"
                  title="Reset Password"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                </button>
              </form>
              
              <!-- Toggle Status -->
              <form action="/admin/users/<%= u._id %>/toggle-status" method="POST" onsubmit="return confirm('<%= u.isActive !== false ? 'Disable' : 'Enable' %> account for <%= u.username %>?')">
                <button 
                  type="submit" 
                  class="p-2 text-gray-400 hover:<%= u.isActive !== false ? 'text-red-400' : 'text-green-400' %> hover:bg-dark-200 rounded transition-colors"
                  title="<%= u.isActive !== false ? 'Disable Account' : 'Enable Account' %>"
                >
                  <% if (u.isActive !== false) { %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                  </svg>
                  <% } else { %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <% } %>
                </button>
              </form>
              
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  
  <!-- Pagination -->
  <% if (pagination.total > 1) { %>
  <div class="px-6 py-4 bg-dark-300 border-t border-dark-100 flex items-center justify-between">
    <p class="text-sm text-gray-400">
      Page <%= pagination.current %> of <%= pagination.total %>
    </p>
    
    <div class="flex gap-2">
      <% if (pagination.hasPrev) { %>
      <a href="/admin/users?page=<%= pagination.current - 1 %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-dark-200 hover:bg-dark-100 text-gray-300 rounded transition-colors">
        Previous
      </a>
      <% } %>
      
      <% if (pagination.hasNext) { %>
      <a href="/admin/users?page=<%= pagination.current + 1 %><%= search ? '&search=' + search : '' %>" 
         class="px-4 py-2 bg-neon-600 hover:bg-neon-700 text-white rounded transition-colors">
        Next
      </a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<script>
// Dropdown toggle
function toggleDropdown(btn) {
  const menu = btn.nextElementSibling;
  
  // Close all other dropdowns
  document.querySelectorAll('.dropdown-menu').forEach(m => {
    if (m !== menu) m.classList.add('hidden');
  });
  
  menu.classList.toggle('hidden');
}

// Close dropdowns when clicking outside
document.addEventListener('click', (e) => {
  if (!e.target.closest('.relative')) {
    document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.add('hidden'));
  }
});
</script>
