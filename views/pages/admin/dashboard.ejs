<%# Admin Dashboard Page %>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  
  <!-- Total Comics -->
  <div class="card rounded-xl p-6 stat-card">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
      </div>
      <span class="text-xs text-green-400 bg-green-400/10 px-2 py-1 rounded">MySQL</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1"><%= stats.comics.total.toLocaleString() %></p>
    <p class="text-sm text-gray-400">Total Comics</p>
  </div>
  
  <!-- Total Chapters -->
  <div class="card rounded-xl p-6 stat-card">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
      </div>
      <span class="text-xs text-green-400 bg-green-400/10 px-2 py-1 rounded">MySQL</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1"><%= stats.chapters.total.toLocaleString() %></p>
    <p class="text-sm text-gray-400">Total Chapters</p>
  </div>
  
  <!-- Total Users -->
  <div class="card rounded-xl p-6 stat-card">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
        </svg>
      </div>
      <span class="text-xs text-yellow-400 bg-yellow-400/10 px-2 py-1 rounded">MongoDB</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1"><%= stats.users.total.toLocaleString() %></p>
    <p class="text-sm text-gray-400">Total Users (<%= stats.users.admins %> admins)</p>
  </div>
  
  <!-- Total Images -->
  <div class="card rounded-xl p-6 stat-card">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-pink-500/20 rounded-lg flex items-center justify-center">
        <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <span class="text-xs text-green-400 bg-green-400/10 px-2 py-1 rounded">MySQL</span>
    </div>
    <p class="text-3xl font-bold text-white mb-1"><%= stats.images.total.toLocaleString() %></p>
    <p class="text-sm text-gray-400">Total Images</p>
  </div>
  
</div>

<!-- Second Row -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  
  <!-- Database Status -->
  <div class="card rounded-xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
      </svg>
      Database Status
    </h3>
    
    <div class="space-y-4">
      <!-- MySQL -->
      <div class="flex items-center justify-between p-3 bg-dark-300 rounded-lg">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full <%= stats.database.mysql.connected ? 'bg-green-400' : 'bg-red-400' %> pulse-dot"></div>
          <span class="text-gray-300">MySQL</span>
        </div>
        <span class="text-sm <%= stats.database.mysql.connected ? 'text-green-400' : 'text-red-400' %>">
          <%= stats.database.mysql.status %>
        </span>
      </div>
      
      <!-- MongoDB -->
      <div class="flex items-center justify-between p-3 bg-dark-300 rounded-lg">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full <%= stats.database.mongodb.connected ? 'bg-green-400' : 'bg-red-400' %> pulse-dot"></div>
          <span class="text-gray-300">MongoDB</span>
        </div>
        <span class="text-sm <%= stats.database.mongodb.connected ? 'text-green-400' : 'text-red-400' %>">
          <%= stats.database.mongodb.status %>
        </span>
      </div>
    </div>
  </div>
  
  <!-- System Info -->
  <div class="card rounded-xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      System Info
    </h3>
    
    <div class="space-y-3 text-sm">
      <div class="flex justify-between">
        <span class="text-gray-400">Uptime</span>
        <span class="text-white font-mono"><%= stats.system.uptimeFormatted %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Node Version</span>
        <span class="text-white font-mono"><%= stats.system.nodeVersion %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Environment</span>
        <span class="text-white font-mono"><%= stats.system.env %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Platform</span>
        <span class="text-white font-mono"><%= stats.system.platform %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">CPUs</span>
        <span class="text-white font-mono"><%= stats.system.cpus %></span>
      </div>
    </div>
  </div>
  
  <!-- Memory Usage -->
  <div class="card rounded-xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
      </svg>
      Memory Usage
    </h3>
    
    <div class="space-y-3 text-sm">
      <div class="flex justify-between">
        <span class="text-gray-400">Heap Used</span>
        <span class="text-white font-mono"><%= stats.system.memory.heapUsed %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">Heap Total</span>
        <span class="text-white font-mono"><%= stats.system.memory.heapTotal %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">RSS</span>
        <span class="text-white font-mono"><%= stats.system.memory.rss %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">System Free</span>
        <span class="text-white font-mono"><%= stats.system.freeMemory %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-gray-400">System Total</span>
        <span class="text-white font-mono"><%= stats.system.totalMemory %></span>
      </div>
    </div>
  </div>
  
</div>

<!-- Quick Actions -->
<div class="card rounded-xl p-6">
  <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
    <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
    </svg>
    Quick Actions
  </h3>
  
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    
    <a href="/admin/users" class="flex flex-col items-center p-4 bg-dark-300 hover:bg-dark-200 rounded-lg transition-colors group">
      <div class="w-12 h-12 bg-neon-600/20 group-hover:bg-neon-600/30 rounded-lg flex items-center justify-center mb-2 transition-colors">
        <svg class="w-6 h-6 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1z"/>
        </svg>
      </div>
      <span class="text-sm text-gray-300 group-hover:text-white transition-colors">Manage Users</span>
    </a>
    
    <a href="/admin/scraper" class="flex flex-col items-center p-4 bg-dark-300 hover:bg-dark-200 rounded-lg transition-colors group">
      <div class="w-12 h-12 bg-green-600/20 group-hover:bg-green-600/30 rounded-lg flex items-center justify-center mb-2 transition-colors">
        <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <span class="text-sm text-gray-300 group-hover:text-white transition-colors">Run Scraper</span>
    </a>
    
    <a href="/admin/logs" class="flex flex-col items-center p-4 bg-dark-300 hover:bg-dark-200 rounded-lg transition-colors group">
      <div class="w-12 h-12 bg-yellow-600/20 group-hover:bg-yellow-600/30 rounded-lg flex items-center justify-center mb-2 transition-colors">
        <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <span class="text-sm text-gray-300 group-hover:text-white transition-colors">View Logs</span>
    </a>
    
    <a href="/comics" class="flex flex-col items-center p-4 bg-dark-300 hover:bg-dark-200 rounded-lg transition-colors group">
      <div class="w-12 h-12 bg-purple-600/20 group-hover:bg-purple-600/30 rounded-lg flex items-center justify-center mb-2 transition-colors">
        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
      </div>
      <span class="text-sm text-gray-300 group-hover:text-white transition-colors">Browse Comics</span>
    </a>
    
  </div>
</div>
