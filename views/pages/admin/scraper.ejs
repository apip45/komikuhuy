<%# Admin Scraper Control Page %>

<% 
  // Determine current status from server-side data
  var isFullRunning = status && status.full && status.full.status === 'running';
  var isLatestRunning = status && status.latest && status.latest.status === 'running';
  var isRunning = isFullRunning || isLatestRunning;
  var runningType = isFullRunning ? 'Full' : (isLatestRunning ? 'Latest' : null);
%>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h2 class="text-2xl font-bold text-white">Scraper Control</h2>
    <p class="text-gray-400 text-sm mt-1">Run and monitor web scrapers</p>
  </div>
  <% if (isRunning) { %>
  <div class="px-4 py-2 bg-dark-300 rounded-lg">
    <span class="text-gray-400 text-sm">Status: </span>
    <span class="text-green-400 font-medium"><%= runningType %> Scraper Running</span>
  </div>
  <% } %>
</div>

<!-- Success/Error Messages from Query Params -->
<% if (typeof query !== 'undefined') { %>
  <% if (query.success) { %>
  <div class="mb-4 p-4 bg-green-900/50 border border-green-500 rounded-lg text-green-400">
    <% if (query.success === 'full_started') { %>
      Full scraper started successfully!
    <% } else if (query.success === 'latest_started') { %>
      Latest scraper started successfully!
    <% } else if (query.success === 'stopped') { %>
      Scraper stopped successfully!
    <% } else { %>
      Operation completed successfully!
    <% } %>
  </div>
  <% } %>
  <% if (query.error) { %>
  <div class="mb-4 p-4 bg-red-900/50 border border-red-500 rounded-lg text-red-400">
    <% if (query.error === 'already_running') { %>
      A scraper is already running!
    <% } else if (query.error === 'no_scraper_running') { %>
      No scraper is currently running.
    <% } else { %>
      An error occurred. Please try again.
    <% } %>
  </div>
  <% } %>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  
  <!-- Scraper Controls -->
  <div class="lg:col-span-1 space-y-6">
    
    <!-- Status Card -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Scraper Status</h3>
      
      <div class="flex items-center gap-3 p-4 bg-dark-300 rounded-lg mb-4">
        <div class="w-3 h-3 rounded-full <%= isRunning ? 'bg-green-400 animate-pulse' : 'bg-gray-500' %>"></div>
        <div class="flex-1">
          <p class="text-white font-medium"><%= isRunning ? 'Running' : 'Idle' %></p>
          <p class="text-sm text-gray-400">
            <% if (isRunning) { %>
              <%= runningType %> scraper is running...
            <% } else { %>
              No scraper running
            <% } %>
          </p>
        </div>
      </div>
      
      <!-- Action Buttons with Forms -->
      <div class="space-y-3">
        <form action="/api/admin/scraper/full" method="POST">
          <!-- Hidden field to enable resume by default -->
          <input type="hidden" name="resume" value="true">
          <button 
            type="submit" 
            <%= isRunning ? 'disabled' : '' %>
            class="w-full px-4 py-3 bg-neon-600 hover:bg-neon-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            <span>Run Full Scraper (Resume)</span>
          </button>
        </form>
        
        <form action="/api/admin/scraper/full" method="POST">
          <input type="hidden" name="reset" value="true">
          <button 
            type="submit" 
            <%= isRunning ? 'disabled' : '' %>
            class="w-full px-4 py-2 bg-yellow-600 hover:bg-yellow-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2 text-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <span>Restart from Page 1</span>
          </button>
        </form>
        
        <form action="/api/admin/scraper/latest" method="POST">
          <button 
            type="submit" 
            <%= isRunning ? 'disabled' : '' %>
            class="w-full px-4 py-3 bg-green-600 hover:bg-green-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Run Latest Only</span>
          </button>
        </form>
        
        <form action="/admin/scraper/fix-chapters" method="POST">
          <button 
            type="submit" 
            <%= isRunning ? 'disabled' : '' %>
            class="w-full px-4 py-3 bg-orange-600 hover:bg-orange-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
            <span>Fix Missing Chapters</span>
          </button>
        </form>
        
        <form action="/api/admin/scraper/stop" method="POST">
          <button 
            type="submit" 
            <%= !isRunning ? 'disabled' : '' %>
            class="w-full px-4 py-3 bg-red-600 hover:bg-red-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
            </svg>
            <span>Stop Scraper</span>
          </button>
        </form>
        
        <p class="text-center text-gray-400 text-sm mt-2">
          <a href="/admin/scraper" class="text-neon-400 hover:underline">↻ Refresh Status</a>
        </p>
      </div>
    </div>
    
    <!-- Progress Info -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Full Scraper Progress</h3>
      
      <div id="progress-info" class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-400">Last Page</span>
          <span id="progress-page" class="text-white font-medium">Loading...</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Status</span>
          <span id="progress-status" class="text-gray-300">Loading...</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Last Updated</span>
          <span id="progress-time" class="text-gray-300">Loading...</span>
        </div>
      </div>
      
      <form action="/admin/scraper/reset-progress" method="POST" class="mt-4">
        <button 
          type="submit"
          onclick="return confirm('Reset progress? Next run will start from page 1.')"
          class="w-full px-3 py-2 bg-dark-300 hover:bg-dark-200 text-gray-300 rounded-lg transition-colors text-sm"
        >
          Reset Progress
        </button>
      </form>
    </div>
    
    <!-- Quick Stats -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Database Stats</h3>
      
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Comics</span>
          <span class="text-white font-medium"><%= dbStats.comics.toLocaleString() %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Chapters</span>
          <span class="text-white font-medium"><%= dbStats.chapters.toLocaleString() %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Images</span>
          <span class="text-white font-medium"><%= dbStats.images.toLocaleString() %></span>
        </div>
      </div>
    </div>
    
    <!-- Scraper Info -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Scraper Info</h3>
      
      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-400">Source</span>
          <span class="text-neon-400">Komiku.org</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Full Scraper</span>
          <span class="text-gray-300">All comics</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Latest Scraper</span>
          <span class="text-gray-300">Recent updates</span>
        </div>
      </div>
    </div>
    
  </div>
  
  <!-- Output Console -->
  <div class="lg:col-span-2">
    <div class="card h-full flex flex-col">
      <div class="p-4 bg-dark-300 border-b border-dark-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <h3 class="text-lg font-semibold text-white">Output Console</h3>
          <span id="output-counter" class="text-xs text-gray-500 font-mono">(0 lines)</span>
        </div>
        
        <div class="flex items-center gap-3">
          <label class="flex items-center gap-2 text-sm text-gray-400">
            <input type="checkbox" id="auto-scroll" checked class="w-4 h-4 rounded bg-dark-400 border-dark-100">
            Auto-scroll
          </label>
          <a 
            href="/admin/scraper/console"
            target="_blank"
            class="text-sm text-gray-400 hover:text-white transition-colors"
          >
            Open in new tab ↗
          </a>
        </div>
      </div>
      
      <!-- Use iframe with auto-refresh for output -->
      <iframe 
        id="output-console" 
        src="/admin/scraper/console"
        class="flex-1 w-full bg-dark-400 border-0"
        style="min-height: 500px; max-height: 700px;"
      ></iframe>
      
      <!-- Console Footer Stats -->
      <div class="p-3 bg-dark-300 border-t border-dark-100 flex items-center justify-between text-xs">
        <div class="flex items-center gap-4">
          <a href="/admin/scraper" class="text-neon-400 hover:underline">↻ Refresh Page</a>
        </div>
        <div id="polling-indicator" class="flex items-center gap-2 text-gray-500">
          <span class="w-2 h-2 rounded-full <%= isRunning ? 'bg-green-400 animate-pulse' : 'bg-gray-600' %>"></span>
          <span><%= isRunning ? 'Auto-refreshing (2s)' : 'Idle' %></span>
        </div>
      </div>
    </div>
  </div>
  
</div>

<!-- Script to load progress info -->
<script>
(function() {
  function loadProgress() {
    fetch('/admin/scraper/progress')
      .then(r => r.json())
      .then(data => {
        const pageEl = document.getElementById('progress-page');
        const statusEl = document.getElementById('progress-status');
        const timeEl = document.getElementById('progress-time');
        
        if (data.success && data.data) {
          pageEl.textContent = 'Page ' + data.data.lastPage;
          statusEl.textContent = data.data.status || 'unknown';
          statusEl.className = data.data.status === 'completed' 
            ? 'text-green-400' 
            : data.data.status === 'error' 
              ? 'text-red-400' 
              : 'text-yellow-400';
          
          if (data.data.lastUpdated) {
            const d = new Date(data.data.lastUpdated);
            timeEl.textContent = d.toLocaleString('id-ID');
          } else {
            timeEl.textContent = '-';
          }
        } else {
          pageEl.textContent = 'No progress';
          statusEl.textContent = 'Not started';
          statusEl.className = 'text-gray-400';
          timeEl.textContent = '-';
        }
      })
      .catch(() => {
        document.getElementById('progress-page').textContent = 'Error';
      });
  }
  
  // Load on page load
  loadProgress();
  
  // Refresh every 5 seconds
  setInterval(loadProgress, 5000);
})();
</script>
