<%# Admin Scraper Control Page %>

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h2 class="text-2xl font-bold text-white">Scraper Control</h2>
    <p class="text-gray-400 text-sm mt-1">Run and monitor web scrapers</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  
  <!-- Scraper Controls -->
  <div class="lg:col-span-1 space-y-6">
    
    <!-- Status Card -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Scraper Status</h3>
      
      <div id="scraper-status" class="flex items-center gap-3 p-4 bg-dark-300 rounded-lg mb-4">
        <div id="status-indicator" class="w-3 h-3 rounded-full bg-gray-500"></div>
        <div>
          <p id="status-text" class="text-white font-medium">Checking...</p>
          <p id="status-detail" class="text-sm text-gray-400">-</p>
        </div>
      </div>
      
      <!-- Action Buttons -->
      <div class="space-y-3">
        <form id="form-full-scraper" action="/admin/scraper/run-full" method="POST" class="w-full">
          <button 
            type="submit" 
            id="btn-full-scraper"
            class="w-full px-4 py-3 bg-neon-600 hover:bg-neon-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
            </svg>
            Run Full Scraper
          </button>
        </form>
        
        <form id="form-latest-scraper" action="/admin/scraper/run-latest" method="POST" class="w-full">
          <button 
            type="submit" 
            id="btn-latest-scraper"
            class="w-full px-4 py-3 bg-green-600 hover:bg-green-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Run Latest Only
          </button>
        </form>
        
        <form id="form-stop-scraper" action="/admin/scraper/stop" method="POST" class="w-full">
          <button 
            type="submit" 
            id="btn-stop-scraper"
            class="w-full px-4 py-3 bg-red-600 hover:bg-red-700 disabled:bg-gray-600 disabled:cursor-not-allowed text-white rounded-lg transition-colors flex items-center justify-center gap-2"
            disabled
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>
            </svg>
            Stop Scraper
          </button>
        </form>
      </div>
    </div>
    
    <!-- Quick Stats -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Database Stats</h3>
      
      <div class="space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Comics</span>
          <span class="text-white font-medium" id="stat-comics">-</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Chapters</span>
          <span class="text-white font-medium" id="stat-chapters">-</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-400">Total Images</span>
          <span class="text-white font-medium" id="stat-images">-</span>
        </div>
      </div>
    </div>
    
    <!-- Scraper Info -->
    <div class="card p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Scraper Info</h3>
      
      <div class="space-y-3 text-sm">
        <div class="flex justify-between">
          <span class="text-gray-400">Source</span>
          <span class="text-neon-400">Komiku.org</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Full Scraper</span>
          <span class="text-gray-300">All comics</span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-400">Latest Scraper</span>
          <span class="text-gray-300">Recent updates</span>
        </div>
      </div>
    </div>
    
  </div>
  
  <!-- Output Console -->
  <div class="lg:col-span-2">
    <div class="card h-full flex flex-col">
      <div class="p-4 bg-dark-300 border-b border-dark-100 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <h3 class="text-lg font-semibold text-white">Output Console</h3>
        </div>
        
        <button 
          onclick="clearOutput()" 
          class="text-sm text-gray-400 hover:text-white transition-colors"
        >
          Clear
        </button>
      </div>
      
      <div 
        id="output-console" 
        class="flex-1 p-4 font-mono text-sm text-gray-300 overflow-auto bg-dark-400"
        style="min-height: 500px; max-height: 700px;"
      >
        <p class="text-gray-500">Waiting for scraper output...</p>
      </div>
    </div>
  </div>
  
</div>

<script>
let pollInterval = null;
let lastOutputLength = 0;

// Initialize
document.addEventListener('DOMContentLoaded', () => {
  checkStatus();
  loadStats();
  
  // Poll status every 3 seconds
  setInterval(checkStatus, 3000);
});

// Check scraper status
async function checkStatus() {
  try {
    const response = await fetch('/api/admin/scraper/status');
    const data = await response.json();
    
    updateStatusUI(data);
    
    if (data.running) {
      startPolling();
    } else {
      stopPolling();
    }
  } catch (error) {
    console.error('Error checking status:', error);
  }
}

// Update status UI
function updateStatusUI(data) {
  const indicator = document.getElementById('status-indicator');
  const text = document.getElementById('status-text');
  const detail = document.getElementById('status-detail');
  const btnFull = document.getElementById('btn-full-scraper');
  const btnLatest = document.getElementById('btn-latest-scraper');
  const btnStop = document.getElementById('btn-stop-scraper');
  
  if (data.running) {
    indicator.className = 'w-3 h-3 rounded-full bg-green-400 animate-pulse';
    text.textContent = 'Running';
    detail.textContent = data.type === 'full' ? 'Full scraper is running...' : 'Latest scraper is running...';
    
    btnFull.disabled = true;
    btnLatest.disabled = true;
    btnStop.disabled = false;
  } else {
    indicator.className = 'w-3 h-3 rounded-full bg-gray-500';
    text.textContent = 'Idle';
    detail.textContent = 'No scraper running';
    
    btnFull.disabled = false;
    btnLatest.disabled = false;
    btnStop.disabled = true;
  }
}

// Start polling output
function startPolling() {
  if (pollInterval) return;
  
  pollInterval = setInterval(fetchOutput, 1000);
  fetchOutput();
}

// Stop polling
function stopPolling() {
  if (pollInterval) {
    clearInterval(pollInterval);
    pollInterval = null;
  }
}

// Fetch scraper output
async function fetchOutput() {
  try {
    const response = await fetch('/api/admin/scraper/output');
    const data = await response.json();
    
    if (data.output && data.output.length > 0) {
      updateOutput(data.output);
    }
  } catch (error) {
    console.error('Error fetching output:', error);
  }
}

// Update output console
function updateOutput(lines) {
  const console = document.getElementById('output-console');
  
  if (lines.length !== lastOutputLength) {
    lastOutputLength = lines.length;
    
    console.innerHTML = lines.map(line => {
      // Color coding based on content
      let className = 'text-gray-300';
      
      if (line.includes('ERROR') || line.includes('error') || line.includes('stderr')) {
        className = 'text-red-400';
      } else if (line.includes('SUCCESS') || line.includes('success') || line.includes('Found')) {
        className = 'text-green-400';
      } else if (line.includes('WARNING') || line.includes('warn')) {
        className = 'text-yellow-400';
      } else if (line.includes('[INFO]') || line.includes('Scraping') || line.includes('Processing')) {
        className = 'text-neon-400';
      } else if (line.includes('---') || line.includes('===')) {
        className = 'text-gray-500';
      }
      
      return `<div class="${className}">${escapeHtml(line)}</div>`;
    }).join('');
    
    // Auto scroll to bottom
    console.scrollTop = console.scrollHeight;
  }
}

// Clear output
function clearOutput() {
  document.getElementById('output-console').innerHTML = '<p class="text-gray-500">Output cleared...</p>';
  lastOutputLength = 0;
}

// Load database stats
async function loadStats() {
  try {
    const response = await fetch('/api/admin/stats');
    const data = await response.json();
    
    document.getElementById('stat-comics').textContent = (data.stats?.comics || 0).toLocaleString();
    document.getElementById('stat-chapters').textContent = (data.stats?.chapters || 0).toLocaleString();
    document.getElementById('stat-images').textContent = (data.stats?.images || 0).toLocaleString();
  } catch (error) {
    console.error('Error loading stats:', error);
  }
}

// Escape HTML
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Handle form submissions
['form-full-scraper', 'form-latest-scraper', 'form-stop-scraper'].forEach(formId => {
  document.getElementById(formId).addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const form = e.target;
    const btn = form.querySelector('button');
    const originalText = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Processing...';
    
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await response.json();
      
      if (data.success) {
        showToast(data.message || 'Operation successful', 'success');
        
        // Clear output on new run
        if (formId !== 'form-stop-scraper') {
          clearOutput();
        }
        
        setTimeout(checkStatus, 500);
      } else {
        showToast(data.message || 'Operation failed', 'error');
      }
    } catch (error) {
      showToast('Request failed', 'error');
    }
    
    btn.innerHTML = originalText;
    setTimeout(checkStatus, 1000);
  });
});

// Toast notification
function showToast(message, type = 'info') {
  const container = document.getElementById('toast-container');
  if (!container) return;
  
  const toast = document.createElement('div');
  toast.className = `px-6 py-3 rounded-lg shadow-lg ${
    type === 'success' ? 'bg-green-600' : 
    type === 'error' ? 'bg-red-600' : 
    'bg-neon-600'
  } text-white`;
  toast.textContent = message;
  
  container.appendChild(toast);
  
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transition = 'opacity 0.3s';
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}
</script>
