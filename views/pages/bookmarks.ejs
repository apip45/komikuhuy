<!-- 
  ===========================================
  AF-Komik V2 - Bookmarks Page
  ===========================================
  
  Displays user's bookmarked comics.
  Features:
  - Grid layout matching comics list
  - Remove bookmark button
  - Resume reading button
  - Pagination
  - Empty state
  
  Data passed from controller:
  - bookmarks: Array of bookmark objects
  - pagination: Pagination metadata
  - user: Current user
-->

<section class="py-8 md:py-12">
  <div class="container mx-auto px-4">
    
    <!-- Page Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">
          <span class="text-neon-400">📚</span> Bookmark Saya
        </h1>
        <p class="text-gray-400">
          <% if (pagination.totalItems > 0) { %>
            Kamu memiliki <span class="text-neon-400 font-semibold"><%= pagination.totalItems %></span> komik di bookmark
          <% } else { %>
            Belum ada komik yang di-bookmark
          <% } %>
        </p>
      </div>
      
      <!-- Action buttons -->
      <div class="flex gap-3">
        <a href="/comics" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Jelajahi Komik
        </a>
      </div>
    </div>
    
    <!-- Success/Error Messages -->
    <% if (query && (query.success || query.error || query.info)) { %>
    <% const msg = query.success || query.error || query.info; %>
    <% const type = query.success ? 'success' : (query.error ? 'error' : 'info'); %>
    <div class="mb-6 p-4 rounded-lg <%= type === 'success' ? 'bg-green-900/30 border border-green-700 text-green-400' : (type === 'error' ? 'bg-red-900/30 border border-red-700 text-red-400' : 'bg-blue-900/30 border border-blue-700 text-blue-400') %>">
      <%= msg %>
    </div>
    <% } %>
    
    <!-- Bookmarks Grid -->
    <% if (bookmarks.length === 0) { %>
    <!-- Empty State - Enhanced -->
    <div class="flex flex-col items-center justify-center py-20 px-4">
      <div class="relative">
        <!-- Animated bookmark icon -->
        <svg class="w-32 h-32 text-gray-600 mb-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
        <div class="absolute inset-0 bg-gradient-to-t from-neon-600/20 to-transparent blur-xl"></div>
      </div>
      
      <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">
        Belum Ada Bookmark
      </h3>
      <p class="text-gray-400 mb-8 text-center max-w-md leading-relaxed">
        Jelajahi koleksi komik dan klik 
        <svg class="w-5 h-5 inline mx-1 text-neon-400" fill="currentColor" viewBox="0 0 24 24">
          <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
        </svg>
        untuk menyimpan komik favorit kamu di sini.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/comics" class="px-8 py-3 bg-neon-600 text-white font-semibold rounded-lg hover:bg-neon-500 transition-all duration-300 flex items-center gap-2 shadow-lg hover:shadow-neon-600/50">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Jelajahi Komik
        </a>
        <a href="/my/history" class="px-8 py-3 bg-dark-300 text-gray-300 font-semibold rounded-lg hover:bg-dark-200 transition-all duration-300 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Lihat Riwayat
        </a>
      </div>
    </div>
    <% } else { %>
    
    <!-- Bookmark Cards Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-3 sm:gap-4 md:gap-6">
      <% bookmarks.forEach(function(bookmark) { %>
      <div class="group relative">
        <a href="/comics/<%= bookmark.comicParam %>" class="block">
          <div class="bg-dark-400 rounded-lg overflow-hidden border border-dark-100 hover:border-neon-600/50 transition-all duration-300 hover:shadow-xl hover:shadow-neon-600/20 hover:-translate-y-1">
            <!-- Thumbnail -->
            <div class="aspect-[3/4] relative overflow-hidden bg-dark-300">
              <% if (bookmark.thumbnail && bookmark.thumbnail !== '/images/no-cover.png') { %>
              <img 
                src="<%= bookmark.thumbnail %>" 
                alt="<%= bookmark.title %>"
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
                onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full bg-gradient-to-br from-dark-300 to-dark-400 flex items-center justify-center\'><svg class=\'w-12 h-12 text-gray-600\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1.5\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\'></path></svg></div>';"
              >
              <% } else { %>
              <div class="w-full h-full bg-gradient-to-br from-dark-300 to-dark-400 flex items-center justify-center">
                <svg class="w-12 h-12 sm:w-16 sm:h-16 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <% } %>
              
              <!-- Latest Chapter Badge -->
              <% if (bookmark.latestChapter) { %>
              <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black via-black/90 to-transparent p-2">
                <span class="text-xs text-neon-400 font-semibold drop-shadow-lg">
                  <%= bookmark.latestChapter %>
                </span>
              </div>
              <% } %>
              
              <!-- Bookmark indicator - Enhanced -->
              <div class="absolute top-2 right-2 z-10 animate-pulse-slow">
                <div class="relative">
                  <!-- Glow effect -->
                  <div class="absolute inset-0 bg-neon-600 rounded-full blur-md opacity-60"></div>
                  
                  <!-- Badge with gradient -->
                  <div class="relative bg-gradient-to-br from-neon-500 to-neon-700 p-2 rounded-full shadow-2xl ring-2 ring-white/20 transform group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white drop-shadow-lg" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Comic Info -->
            <div class="p-2 sm:p-3">
              <h3 class="text-xs sm:text-sm font-semibold text-white line-clamp-2 group-hover:text-neon-400 transition-colors min-h-[2.5rem] leading-tight">
                <%= bookmark.title %>
              </h3>
              
              <!-- Genres -->
              <% if (bookmark.genres && bookmark.genres.length > 0) { %>
              <div class="mt-2 flex flex-wrap gap-1 hidden sm:flex">
                <% bookmark.genres.slice(0, 2).forEach(function(genre) { %>
                <span class="text-xs px-2 py-0.5 rounded bg-dark-300 text-gray-400 line-clamp-1">
                  <%= genre %>
                </span>
                <% }); %>
              </div>
              <% } %>
              
              <!-- Added date -->
              <p class="text-xs text-gray-500 mt-2 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="hidden sm:inline">
                  <%= new Date(bookmark.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
                <span class="sm:hidden">
                  <%= new Date(bookmark.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
                </span>
              </p>
            </div>
          </div>
        </a>
        
        <!-- Action Buttons (on hover) - Enhanced -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-3">
          <div class="flex gap-2">
            <!-- Resume Reading -->
            <a 
              href="/comics/<%= bookmark.comicParam %>" 
              class="flex-1 py-2.5 bg-neon-600 text-white text-xs font-semibold text-center rounded-lg hover:bg-neon-500 transition-all duration-300 flex items-center justify-center gap-1 shadow-lg hover:shadow-neon-600/50"
              title="Baca Komik"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              Baca
            </a>
            <!-- Remove Bookmark -->
            <button 
              onclick="removeBookmarkWithConfirm('<%= bookmark.comicParam %>', '<%= bookmark.title %>', this)"
              class="p-2.5 bg-red-600/90 text-white rounded-lg hover:bg-red-500 transition-all duration-300 shadow-lg hover:shadow-red-600/50"
              title="Hapus dari Bookmark"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    
    <!-- Pagination -->
    <% if (pagination.total > 1) { %>
    <div class="mt-12 flex justify-center">
      <nav class="flex items-center gap-2">
        <!-- Previous Button -->
        <% if (pagination.hasPrev) { %>
        <a href="/my/bookmarks?page=<%= pagination.current - 1 %>" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 text-gray-600 rounded-lg cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </span>
        <% } %>
        
        <!-- Page Numbers -->
        <% 
        const maxPages = 5;
        let startPage = Math.max(1, pagination.current - Math.floor(maxPages / 2));
        let endPage = Math.min(pagination.total, startPage + maxPages - 1);
        if (endPage - startPage + 1 < maxPages) {
          startPage = Math.max(1, endPage - maxPages + 1);
        }
        %>
        
        <% for (let i = startPage; i <= endPage; i++) { %>
        <a 
          href="/my/bookmarks?page=<%= i %>" 
          class="px-4 py-2 rounded-lg transition-colors <%= i === pagination.current ? 'bg-neon-600 text-white' : 'bg-dark-300 text-gray-300 hover:bg-dark-200' %>"
        >
          <%= i %>
        </a>
        <% } %>
        
        <!-- Next Button -->
        <% if (pagination.hasNext) { %>
        <a href="/my/bookmarks?page=<%= pagination.current + 1 %>" class="px-4 py-2 bg-dark-300 text-gray-300 rounded-lg hover:bg-dark-200 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-dark-400 text-gray-600 rounded-lg cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
        <% } %>
      </nav>
    </div>
    <% } %>
    
    <% } %>
  </div>
</section>

<style>
/* Custom slow pulse animation for bookmark badge */
@keyframes pulse-slow {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.8;
  }
}

.animate-pulse-slow {
  animation: pulse-slow 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
</style>

<script>
// Remove bookmark with confirmation and smooth animation
function removeBookmarkWithConfirm(comicParam, comicTitle, button) {
  // Confirmation dialog
  if (!confirm(`Hapus "${comicTitle}" dari bookmark?`)) {
    return;
  }
  
  const card = button.closest('.group');
  
  // Disable button to prevent double click
  button.disabled = true;
  button.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>';
  
  // API call to remove bookmark
  fetch(`/api/bookmarks/${comicParam}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Smooth fade out animation
      card.style.transition = 'all 0.3s ease-out';
      card.style.opacity = '0';
      card.style.transform = 'scale(0.9)';
      
      // Remove from DOM after animation
      setTimeout(() => {
        card.remove();
        
        // Check if grid is empty now
        const grid = document.querySelector('.grid');
        if (grid && grid.children.length === 0) {
          // Reload page to show empty state
          window.location.reload();
        }
        
        // Show success notification
        showNotification('✓ Bookmark berhasil dihapus', 'success');
      }, 300);
    } else {
      throw new Error(data.message || 'Gagal menghapus bookmark');
    }
  })
  .catch(error => {
    console.error('Error removing bookmark:', error);
    showNotification('✗ Gagal menghapus bookmark', 'error');
    
    // Re-enable button
    button.disabled = false;
    button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
  });
}

// Show notification toast
function showNotification(message, type = 'info') {
  const toast = document.createElement('div');
  toast.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300 ${
    type === 'success' ? 'bg-green-600 text-white' : 
    type === 'error' ? 'bg-red-600 text-white' : 
    'bg-blue-600 text-white'
  }`;
  toast.textContent = message;
  toast.style.opacity = '0';
  toast.style.transform = 'translateY(-20px)';
  
  document.body.appendChild(toast);
  
  // Trigger animation
  setTimeout(() => {
    toast.style.opacity = '1';
    toast.style.transform = 'translateY(0)';
  }, 10);
  
  // Remove after 3 seconds
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transform = 'translateY(-20px)';
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

// Add lazy loading for images
document.addEventListener('DOMContentLoaded', function() {
  // Lazy loading already handled by loading="lazy" attribute
  
  // Add loading error handler for all images
  const images = document.querySelectorAll('img[src]');
  images.forEach(img => {
    if (!img.complete) {
      img.addEventListener('error', function() {
        console.warn('Failed to load image:', this.src);
      });
    }
  });
});
</script>
