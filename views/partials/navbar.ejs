                    d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
            </svg>
            Bookmarks
          </a>
          
          <a href="/my/history" 
             class="px-4 py-2 rounded-lg text-gray-300 hover:text-white hover:bg-dark-200 transition-default
