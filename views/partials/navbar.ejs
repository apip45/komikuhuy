<!-- 
  ===========================================
  AF-Komik V2 - Navigation Bar Partial
  ===========================================
  
  Responsive navigation bar with:
  - Logo/brand
  - Navigation links
  - Mobile hamburger menu
  - Neon blue accent styling
  - Conditional auth buttons (login/register or user menu)
-->

<nav class="bg-dark-400 border-b border-dark-100 sticky top-0 z-50">
