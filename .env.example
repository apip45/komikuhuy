# ===========================================
# AF-Komik V2 Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# 
# IMPORTANT: Never commit .env file to version control!
# This file contains sensitive credentials.

# ===========================================
# Server Configuration
# ===========================================
# NODE_ENV: 'development' or 'production'
# - development: enables debug logging, shows detailed errors
# - production: optimized for performance, hides sensitive errors
NODE_ENV=development

# PORT: The port number the server will listen on
PORT=3000

# ===========================================
# MongoDB Configuration
# ===========================================
# MongoDB Atlas is used for:
# - Users (authentication data)
# - Sessions (login sessions)
# - Bookmarks (user bookmarks)
# - Reading History (user progress tracking)
# 
# Get your connection string from MongoDB Atlas:
# https://cloud.mongodb.com/
# 
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (will be created if doesn't exist)
MONGODB_DBNAME=af_komik_v2

# ===========================================
# MySQL Configuration
# ===========================================
# MySQL is used for:
# - komik (comic metadata)
# - chapter (chapter information)
# - image (page images)
# 
# Create the database and run schema.sql before starting the server
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=af_komik

# ===========================================
# Session Configuration
# ===========================================
# SESSION_SECRET: A long random string used to sign session cookies
# IMPORTANT: Generate a secure random string for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_super_secret_session_key_at_least_32_characters_long_change_this_in_production

# SESSION_MAX_AGE: Session duration in milliseconds
# Default: 86400000 (24 hours = 24 * 60 * 60 * 1000)
# 1 hour = 3600000
# 7 days = 604800000
SESSION_MAX_AGE=86400000

# ===========================================
# Cookie Configuration
# ===========================================
# COOKIE_SECURE: Set to 'true' in production (requires HTTPS)
# In development, set to 'false' to work with HTTP
COOKIE_SECURE=false

# ===========================================
# Cache Configuration
# ===========================================
# CACHE_ENABLED: Enable/disable caching system
# Set to 'false' to disable caching (useful for debugging)
CACHE_ENABLED=true

# Cache is automatically configured with:
# - HOT tier: 30 minutes TTL, 30 keys max (genres, stats)
# - WARM tier: 30 minutes TTL, 100 keys max (comic details)
# - COLD tier: 24 hours TTL, 100 keys max (published chapters)
# 
# Memory monitoring: Auto-cleanup when heap > 400MB
# Target memory usage: < 200MB for cache
